# ─────────────────────────────────────────────────────────────────────────────
# Aayat al-Ruh — environment variables
# Every integration is optional in development: when a key is missing the
# feature degrades gracefully (noted on each line) so the site still runs.
# ─────────────────────────────────────────────────────────────────────────────

# Database (required). Local: `pnpm db:start` prints this URL.
# Production (Supabase → Connect): the Transaction pooler string, port 6543.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Production only: Supabase Session pooler string (port 5432), used by `pnpm db:deploy`
# to create/upgrade tables. Leave empty locally.
DIRECT_URL=""
# Optional: Supabase SSL certificate (Project Settings → Database → SSL Configuration) to
# verify the database server. Supabase connections are encrypted either way.
DATABASE_CA_CERT=""
# Only needed for `prisma migrate dev` against the local prisma dev server
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Public URL of the site (used for SEO, emails, OG images, payment callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth (required). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the Google button is hidden when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paytm Payment Gateway (optional in dev — without these only Cash on Delivery is offered)
# Paytm for Business dashboard → Developer Settings → API Keys. Use the Test keys with
# PAYTM_ENV="staging", then the Production keys with PAYTM_ENV="production".
# Webhook: set the Payment Notification URL to https://<domain>/api/paytm/webhook
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
PAYTM_ENV="staging"
# Optional — defaults to WEBSTAGING (staging) / DEFAULT (production)
PAYTM_WEBSITE=""

# Email via Resend (optional — without a key emails are printed to the server console)
RESEND_API_KEY=""
EMAIL_FROM="Aayat al-Ruh <hello@aayatalruh.com>"

# AI Scent Concierge (optional — the Concierge is hidden when unset)
ANTHROPIC_API_KEY=""
# Optional overrides — default model claude-opus-5, default effort medium (low | medium | high)
CONCIERGE_MODEL=""
CONCIERGE_EFFORT=""

# Analytics (optional — nothing loads until a visitor accepts cookies in the banner)
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=""
# Meta (Facebook/Instagram) Pixel ID — digits only
NEXT_PUBLIC_META_PIXEL_ID=""

# Demo reviews, testimonials and stats show in development and stay hidden in
# production. Set "true" on a staging copy to preview them, "false" to hide them locally.
DEMO_CONTENT=""

# Database connections per server instance (default 10; local dev uses 3)
DATABASE_POOL_MAX=""
# Build workers — only needed when building against the local `prisma dev` database,
# e.g. DATABASE_POOL_MAX=1 NEXT_BUILD_CPUS=2 pnpm build (stop `pnpm dev` first)
NEXT_BUILD_CPUS=""

# Seeded admin account (used once by `pnpm db:seed`) — use a strong password,
# then add the owner's own account in Admin → Settings → Admin team
SEED_ADMIN_EMAIL="admin@aayatalruh.com"
SEED_ADMIN_PASSWORD="change-me"
